{
  "categories": {
    "Images": {
      "folder": "Images",
      "extensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg", ".ico", ".tiff"]
    },
    "PDFs": {
      "folder": "PDFs",
      "extensions": [".pdf"]
    },
    "Documents": {
      "folder": "Documents",
      "extensions": [".doc", ".docx", ".txt", ".rtf", ".odt"]
    },
    "Spreadsheets": {
      "folder": "Spreadsheets",
      "extensions": [".xls", ".xlsx", ".csv", ".ods"]
    },
    "Presentations": {
      "folder": "Presentations",
      "extensions": [".ppt", ".pptx", ".odp"]
    },
    "Videos": {
      "folder": "Videos",
      "extensions": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".wmv", ".flv", ".m4v"]
    },
    "Audio": {
      "folder": "Audio",
      "extensions": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a"]
    },
    "Archives": {
      "folder": "Archives",
      "extensions": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2"]
    },
    "Code": {
      "folder": "Code",
      "extensions": [".py", ".js", ".ts", ".html", ".css", ".java", ".cpp", ".c", ".cs", ".php", ".go", ".rs", ".json", ".xml", ".sql"]
    },
    "Applications": {
      "folder": "Applications",
      "extensions": [".exe", ".msi", ".apk"]
    },
    "Fonts": {
      "folder": "Fonts",
      "extensions": [".ttf", ".otf", ".woff", ".woff2"]
    }
  },
  "default_folder_for_unknown": "Others"
}
